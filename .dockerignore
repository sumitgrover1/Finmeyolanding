# Keep the build context to source. Without this, `COPY . .` in the builder
# stage copies a developer's node_modules and .next over the ones the deps
# stage just installed, and a stale .next can make the build lie.
node_modules
.next
.git
.env
.env.*
!.env.example
!.env.production.example
*.log
README.md
Caddyfile.snippet
