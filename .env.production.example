# Copy to .env on the server. Read by Docker Compose, so the build args above
# pick these up.

# The Docker network the reverse proxy serving finmeyo.com is already on.
PROXY_NETWORK=app_default

NEXT_PUBLIC_API_BASE=https://finmeyo.com
NEXT_PUBLIC_SITE_URL=https://loan.finmeyo.com
NEXT_PUBLIC_COOKIE_DOMAIN=.finmeyo.com

# Reload the proxy after a deploy, if it is Caddy. Leave unset otherwise.
# CADDY_CONTAINER=app-caddy-1
