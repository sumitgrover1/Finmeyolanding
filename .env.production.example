# Copy to .env on the server. Read by Docker Compose, so the build args in
# docker-compose.yml pick these up too.

# The Docker network the reverse proxy serving finmeyo.com is already on.
PROXY_NETWORK=app_default

NEXT_PUBLIC_API_BASE=https://finmeyo.com
NEXT_PUBLIC_SITE_URL=https://loan.finmeyo.com
NEXT_PUBLIC_COOKIE_DOMAIN=

# The shared key. Generate with `openssl rand -hex 32` and set the identical
# value on the main site as LANDING_API_KEY. Without it the page still renders,
# but it shows no rates and the form cannot submit.
LANDING_API_KEY=

# Reload the proxy after a deploy, if it is Caddy. Leave unset otherwise.
# CADDY_CONTAINER=app-caddy-1
