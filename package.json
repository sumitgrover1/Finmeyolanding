{
  "name": "finmeyo-loans-landing",
  "version": "1.0.0",
  "private": true,
  "description": "The loans landing page at loan.finmeyo.com. No database: it reads rates and posts leads to finmeyo.com's public endpoints.",
  "scripts": {
    "dev": "next dev --turbopack -p 3100",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "next start -p 3100",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:content": "tsx tests/content.ts",
    "check": "npm run typecheck && npm run lint && npm run test:content"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.0"
  }
}
