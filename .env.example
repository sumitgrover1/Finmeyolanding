# Where the rates come from and where the leads go. The main site must list
# this app's origin in its own LANDING_ORIGINS, or the browser will refuse the
# cross-origin POST.
NEXT_PUBLIC_API_BASE=https://finmeyo.com

# This app's own address: canonical links, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://loan.finmeyo.com

# The attribution cookie is written for this domain so the main site can read
# it when the form posts back. Must be the registrable domain with a leading
# dot, and must match the main site's NEXT_PUBLIC_COOKIE_DOMAIN exactly.
NEXT_PUBLIC_COOKIE_DOMAIN=.finmeyo.com

# There is deliberately no DATABASE_URL, no session secret and no API key here.
# If you find yourself needing one, something has gone wrong with the design —
# this app is meant to hold nothing worth stealing.
