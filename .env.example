# Where the rates come from and where the leads go.
NEXT_PUBLIC_API_BASE=https://finmeyo.com

# This app's own address: canonical links, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://loan.finmeyo.com

# --- the one secret this app has ---
#
# The key the main site checks before it will serve the rate table, or believe
# this server about a visitor's address and which advertisement brought them.
# It is read on the server only and never reaches the browser.
#
# Generate one with:  openssl rand -hex 32
# Set the SAME value on the main site as LANDING_API_KEY.
#
# NEVER commit a real value. This file is an example; the real one lives in
# .env / .env.local, which .gitignore keeps out of git.
LANDING_API_KEY=

# Only needed if a visitor should carry their attribution between finmeyo.com
# and this host. The form does not depend on it — this server reads the cookie
# from the request and relays it. Must match the main site's value.
NEXT_PUBLIC_COOKIE_DOMAIN=.finmeyo.com

# There is deliberately no DATABASE_URL and no session secret here. If you find
# yourself needing one, something has gone wrong with the design — this app is
# meant to hold nothing that reads customer data.
